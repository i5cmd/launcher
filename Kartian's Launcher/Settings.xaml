<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kartian_s_Launcher.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kartian_s_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <ComboBox SelectionChanged="AppComboBox_SelectionChanged" x:Name="AppComboBox" Header="App" PlaceholderText="Pick an app" ItemsSource="{x:Bind gimmeit}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:AppDetails">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="3">
                            <Image Width="30" Height="30" Source="{x:Bind IconPath}" Margin="2"></Image>
                            <TextBlock Text="{x:Bind Name}" Margin="2"></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ListBox x:Name="ModifierSelection" SelectionChanged="ModifierSelection_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBoxItem Content="Alt" x:Name="Menu"></ListBoxItem>
                <ListBoxItem Content="Windows" x:Name="LWindows"></ListBoxItem>
                <ListBoxItem Content="Ctrl" x:Name="Control"></ListBoxItem>
                <ListBoxItem Content="Shift" x:Name="Shift"></ListBoxItem>
            </ListBox>
            <TextBox Header="Shortcut" x:Name="ShortcutInput" KeyDown="ShortcutInput_KeyDown" IsReadOnly="True"></TextBox>
            <Button Grid.Row="0" x:Name="AddShortcut" Click="AddShortcut_Click">+ Add</Button>
        </StackPanel>
        <ListView Grid.Row="1" x:Name="ShortcutsList" ItemsSource="{x:Bind shortcuters}" Width="500" Height="600">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ShortcutDetails">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="30" Height="30" Source="{x:Bind app.IconPath}" Margin="2"></Image>
                        <StackPanel Orientation="Vertical">
                            <TextBlock FontWeight="Bold" Text="{x:Bind app.Name}" Margin="2"></TextBlock>
                            <TextBlock FontStyle="Italic" Text="{x:Bind inputsOne}" Margin="2"></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>