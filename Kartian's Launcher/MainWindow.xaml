<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kartian_s_Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kartian_s_Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kartian's Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Exit" x:Name="ExitProgram" Click="ExitProgram_Click"></MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Content">
                <MenuFlyoutItem Text="Run" x:Name="RunItem" Click="RunItem_Click"></MenuFlyoutItem>
                <MenuFlyoutItem Text="Add" x:Name="AddItem" Click="AddItem_Click"></MenuFlyoutItem>
                <MenuFlyoutItem Text="Edit" x:Name="EditItem" Click="EditItem_Click"></MenuFlyoutItem>
                <MenuFlyoutItem Text="Remove" x:Name="RemoveItem" Click="RemoveItem_Click"></MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ListView Grid.Column="0" x:Name="Programs" ItemsSource="{x:Bind ProgramsDetails}" SelectionChanged="Programs_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AppDetails">
                        <StackPanel Orientation="Horizontal" MaxWidth="360">
                            <Border Width="40" Height="40" CornerRadius="6" Margin="5">
                                <Image Source="{x:Bind IconPath}" Stretch="UniformToFill"></Image>
                            </Border>
                            <StackPanel Orientation="Vertical">
                                <TextBlock FontWeight="Bold" Text="{x:Bind Name}"></TextBlock>
                                <TextBlock FontWeight="Normal" Text="{x:Bind Path}"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="12"  Width="150" Height="150" Margin="5">
                        <Image Stretch="UniformToFill" x:Name="Iconx2"></Image>
                    </Border>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Margin="2" FontWeight="Bold" FontSize="35" VerticalAlignment="Bottom" x:Name="Titlex2"></TextBlock>
                        <TextBlock Margin="2" FontWeight="Normal" FontSize="16" VerticalAlignment="Bottom" x:Name="Authorx2"></TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Margin="3" Style="{StaticResource AccentButtonStyle}" Click="RunItem_Click">Run</Button>
                    <Button Margin="3" Click="EditItem_Click">Edit</Button>
                </StackPanel>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="2" FontWeight="Bold" FontSize="12" VerticalAlignment="Bottom">Path: </TextBlock>
                        <TextBlock Margin="2" FontWeight="Normal" FontSize="12" VerticalAlignment="Bottom" x:Name="Pathx2"></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="2" FontWeight="Bold" FontSize="12" VerticalAlignment="Bottom">Description:</TextBlock>
                        <TextBlock Margin="2" FontWeight="Normal" FontSize="12" VerticalAlignment="Bottom" x:Name="Descx2"></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="2" FontWeight="Bold" FontSize="12" VerticalAlignment="Bottom">Size:</TextBlock>
                        <TextBlock Margin="2" FontWeight="Normal" FontSize="12" VerticalAlignment="Bottom" x:Name="Sizex2"></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="2" FontWeight="Bold" FontSize="12" VerticalAlignment="Bottom">Date:</TextBlock>
                        <TextBlock Margin="2" FontWeight="Normal" FontSize="12" VerticalAlignment="Bottom" x:Name="Datex2"></TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
